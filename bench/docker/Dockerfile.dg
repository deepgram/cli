# dg built from a source tree of this repo (the build context is a clean
# `git archive` of the ref under test). Installed the way users get the Python
# path: `uv tool install` with bytecode compiled. Nothing in this build runs
# deepctl itself. tools.sh comes from the named build context `benchctx`.
ARG PY_IMAGE
ARG UV_IMAGE
FROM ${UV_IMAGE} AS uv

FROM ${PY_IMAGE} AS wheels
COPY --from=uv /uv /usr/local/bin/uv
COPY . /src
WORKDIR /src
RUN mkdir -p /dist \
 && for p in packages/*/; do uv build -q --wheel "$p" --out-dir /dist; done \
 && uv build -q --wheel . --out-dir /dist \
 && rm -f /dist/deepctl_plugin_example-*.whl \
 && uv export -q --frozen --no-dev --all-packages --no-emit-workspace --no-hashes -o /dist/constraints.txt

FROM ${PY_IMAGE}
ARG HYPERFINE_VERSION
ARG HYPERFINE_SHA_ARM64
ARG HYPERFINE_SHA_AMD64
# DEPS=lock pins third-party versions from uv.lock (reproducible; the gate default).
# DEPS=latest resolves them from the index at build time, as a user's install does.
ARG DEPS=lock
COPY --from=benchctx tools.sh /tmp/tools.sh
RUN sh /tmp/tools.sh "$HYPERFINE_VERSION" "$HYPERFINE_SHA_ARM64" "$HYPERFINE_SHA_AMD64" && rm /tmp/tools.sh
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=wheels /dist /tmp/dist
USER u
WORKDIR /home/u
ENV PATH=/home/u/.local/bin:$PATH UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
RUN set -e; root=$(ls /tmp/dist/deepctl-*.whl); \
    withs=$(ls /tmp/dist/*.whl | grep -v "^$root\$" | sed 's/^/--with /'); \
    uv tool install -q --compile-bytecode --python /usr/local/bin/python3 \
      $( [ "$DEPS" = lock ] && echo "-c /tmp/dist/constraints.txt" ) $withs "$root" \
 && d=/home/u/.local/share/uv/tools/deepctl \
 && ver=$(basename "$root" | cut -d- -f2) \
 && printf '{"install_mb": %s, "dists": %s, "version": "%s", "deps": "%s"}\n' \
      "$(du -sm $d | cut -f1)" "$(ls -d $d/lib/python*/site-packages/*.dist-info | wc -l)" "$ver" "$DEPS" > /home/u/.bench-meta.json
USER root
RUN mv /home/u/.bench-meta.json /opt/bench/meta.json && rm -rf /tmp/dist /usr/local/bin/uv
USER u
