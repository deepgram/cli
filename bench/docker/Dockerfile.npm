# A competitor shipped on npm, installed globally at a pinned version.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG HYPERFINE_VERSION
ARG HYPERFINE_SHA_ARM64
ARG HYPERFINE_SHA_AMD64
ARG PACKAGE
ARG VERSION
COPY tools.sh /tmp/tools.sh
RUN sh /tmp/tools.sh "$HYPERFINE_VERSION" "$HYPERFINE_SHA_ARM64" "$HYPERFINE_SHA_AMD64" && rm /tmp/tools.sh
RUN npm i -g --no-fund --no-audit --loglevel=error "$PACKAGE@$VERSION" \
 && printf '{"install_mb": %s, "version": "%s"}\n' "$(du -sm /usr/local/lib/node_modules/$PACKAGE | cut -f1)" "$VERSION" > /opt/bench/meta.json \
 && npm cache clean --force >/dev/null 2>&1
USER u
WORKDIR /home/u
