    {"id": "D.forbidden.subhelp", "target": "deterministic", "subject": "dg", "row": "imports_subhelp", "op": "==", "value": 0, "unit": "count", "kind": "deterministic", "since": "0.5.0", "target_text": "the forbidden-module lists"},
