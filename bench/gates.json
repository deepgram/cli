    {"id": "D.allowlist.version", "target": "deterministic", "subject": "dg", "row": "imports_version_allowlist", "op": "==", "value": 0, "unit": "count", "kind": "deterministic", "since": "0.5.0", "target_text": "the import allowlist"},
    {"id": "D.allowlist.mcp", "target": "deterministic", "subject": "dg", "row": "imports_mcp_allowlist", "op": "==", "value": 0, "unit": "count", "kind": "deterministic", "since": "0.5.0", "target_text": "the import allowlist"},
