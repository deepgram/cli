          "name": "choice",
          "choices": [
            "json",
            "yaml",
            "table",
            "csv"
          ],
          "case_sensitive": false
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": false,
        "multiple": false,
        "is_flag": false,
        "count": false,
        "hidden": false,
        "help": "Output format (same as the global -o before the command)."
      },
      {
        "class": "option",
        "name": "quiet",
        "opts": [
          "--quiet",
          "-q"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
