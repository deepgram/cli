      {
        "class": "option",
        "name": "verbose",
        "opts": [
          "--verbose",
          "-v"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": false,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Enable verbose output."
