{
  "name": "completion",
  "module": "deepctl_cmd_completion.command",
  "attr": "CompletionCommand",
  "dist": "deepctl-cmd-completion",
  "summary": "Generate shell completion",
  "hidden": false,
  "requires_auth": false,
  "help": {
    "name": "completion",
    "help": "Generate shell completion script for bash, zsh, or fish\n\nExamples:\n  dg completion\n  dg completion bash\n  dg completion zsh\n  dg completion fish\n  eval \"$(dg completion bash)\"\n  dg completion zsh --install\n\n\nFor agents, use --agent-friendly.",
    "short_help": "Generate shell completion",
    "epilog": null,
    "hidden": false,
    "deprecated": false,
    "no_args_is_help": false,
    "options_metavar": "[OPTIONS]",
    "params": [
      {
        "class": "option",
        "name": "install",
        "opts": [
          "--install"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": true,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Append completion line to shell profile and exit"
      },
      {
        "class": "argument",
        "name": "shell",
        "opts": [
          "shell"
        ],
        "secondary_opts": [],
        "type": {
          "name": "text"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": true
      },
      {
        "class": "option",
        "name": "agent_friendly",
        "opts": [
          "--agent-friendly"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": true,
        "expose": false,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Output machine-readable JSON metadata for this command and exit."
      },
      {
        "class": "option",
        "name": "non_interactive",
        "opts": [
          "--non-interactive"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": false,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Skip interactive prompts; use defaults for any optional features."
      },
      {
        "class": "option",
        "name": "output",
        "opts": [
          "--output",
          "-o"
