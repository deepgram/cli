{
  "name": "init",
  "module": "deepctl_cmd_init.command",
  "attr": "InitCommand",
  "dist": "deepctl-cmd-init",
  "summary": "Scaffold a Deepgram starter app (alpha)",
  "hidden": false,
  "requires_auth": false,
  "help": {
    "name": "init",
    "help": "Browse, clone, and set up Deepgram starter apps.\n\nFetches templates from the Deepgram templates gallery. Run with no arguments for an interactive search-and-select picker, or pass a template name directly to clone immediately.\n\nExamples:\n  dg init\n  dg init --search python\n  dg init node-transcription\n  dg init node-transcription --dir ./my-app\n  dg init node-transcription --install\n  dg init node-transcription --no-install\n  dg init --list\n  dg init --list --search flask\n\n\nFor agents, use --agent-friendly.",
    "short_help": "Scaffold a Deepgram starter app (alpha)",
    "epilog": null,
    "hidden": false,
    "deprecated": false,
    "no_args_is_help": false,
    "options_metavar": "[OPTIONS]",
    "params": [
      {
        "class": "option",
        "name": "no_start",
        "opts": [
          "--no-start"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": true,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Skip start step without prompting"
      },
