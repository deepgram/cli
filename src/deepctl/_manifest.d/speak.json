        "multiple": false,
        "is_flag": false,
        "count": false,
        "hidden": false,
        "help": "Flux TTS (v2) only. Speech-rate multiplier: 0.85, 0.90, 0.95, 1.00, 1.05, 1.10, or 1.15 (1.00 = nominal)."
