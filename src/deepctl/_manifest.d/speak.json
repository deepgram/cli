        "metavar": null,
        "eager": false,
        "expose": true,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Play the audio through your system player (ffplay, afplay, paplay, or aplay). Can be combined with --out-file to save and play."
