{
  "name": "speak",
  "module": "deepctl_cmd_speak.command",
  "attr": "SpeakCommand",
  "dist": "deepctl-cmd-speak",
  "summary": "Text-to-speech",
  "hidden": false,
  "requires_auth": true,
  "help": {
    "name": "speak",
    "help": "Convert text to speech using Deepgram TTS\n\nExamples:\n  dg speak \"Hello from Deepgram\" --play\n  dg speak --list-voices\n  dg speak \"Hello world\"\n  dg speak \"Hello world\" --out-file hello.wav\n  dg speak \"Hello world\" --out-file hello.wav --play\n  dg speak --file message.txt --out-file output.wav\n  dg speak \"Hello\" | ffplay -loglevel error -nodisp -autoexit -\n  dg speak \"A little slower, please\" --speed 0.9 --out-file slow.wav\n  dg speak \"So exciting!\" --expressivity 2 --out-file lively.wav  # beta; default: 0\n  dg speak \"Hello\" -m aura-2-asteria-en --out-file hello.mp3\n  dg speak \"Hello\" -m aura-2-luna-en --out-file hello.wav --encoding linear16 --container wav\n  echo \"Hello\" | dg speak - --out-file hello.mp3 -m aura-2-asteria-en\n  dg speak \"Hola, mundo\" -m aura-2-selena-es --out-file hola.mp3\n\n\nFor agents, use --agent-friendly.",
    "short_help": "Text-to-speech",
    "epilog": null,
    "hidden": false,
    "deprecated": false,
    "no_args_is_help": false,
    "options_metavar": "[OPTIONS]",
    "params": [
      {
        "class": "option",
        "name": "list_voices",
        "opts": [
          "--list-voices"
        ],
        "secondary_opts": [],
        "type": {
          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": true,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "List available TTS voices and exit (no speech generated)"
      },
