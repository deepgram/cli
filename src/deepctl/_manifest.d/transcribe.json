          "name": "boolean"
        },
        "required": false,
        "nargs": 1,
        "metavar": null,
        "eager": false,
        "expose": true,
        "multiple": false,
        "is_flag": true,
        "count": false,
        "hidden": false,
        "help": "Output SRT captions instead of plain transcript. In live mode, entries are printed as they arrive. Mutually exclusive with --webvtt."
