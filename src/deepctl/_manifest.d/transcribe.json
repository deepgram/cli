{
  "name": "transcribe",
  "module": "deepctl_cmd_transcribe.command",
  "attr": "TranscribeCommand",
  "dist": "deepctl-cmd-transcribe",
  "summary": "Transcribe audio (deprecated alias for dg listen)",
  "hidden": true,
  "requires_auth": true,
  "help": {
    "name": "transcribe",
    "help": "Transcribe audio files or URLs using Deepgram.\n\nThis command is a deprecated alias for `dg listen`. Use `dg listen` for all new scripts.\n\nExamples:\n  dg listen audio.mp3\n  dg listen https://example.com/call.mp3 --diarize\n  dg listen --mic --model nova-3 --interim\n  dg listen audio.mp3 --diarize --summarize --save-to transcript.txt\n  dg listen call.wav --redact numbers --numerals\n  dg listen --mic --model flux-general-en --redact aggressive_numbers\n  dg -o json listen audio.mp3 | jq '.results.channels[0].alternatives[0].transcript'\n  ffmpeg -i video.mp4 -f s16le -ar 16000 -ac 1 - | dg listen --encoding linear16\n  dg listen -  # read raw audio from stdin interactively\n\n\nFor agents, use --agent-friendly.",
    "short_help": "Transcribe audio (deprecated alias for dg listen)",
    "epilog": null,
    "hidden": true,
    "deprecated": false,
    "no_args_is_help": false,
    "options_metavar": "[OPTIONS]",
