        ))}
      </div>
    </div>

    <!-- ══════════════════════════════════════ BENTO ══ -->
    <section class="py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="font-black tracking-tight mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
            Everything speech AI. One command.
          </h2>
          <p class="text-dg-muted text-base max-w-lg mx-auto">Built for developers who live in the terminal and need their tools to keep up.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

          <!-- STT — tall card -->
          <div class="gb-green rounded-2xl lg:row-span-2 group hover:shadow-lg hover:shadow-dg-green/5 transition-shadow">
            <div class="rounded-2xl h-full bg-dg-charcoal p-6 flex flex-col" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #13ef9515; border: 1px solid #13ef9530;">
                <svg class="w-5 h-5 text-dg-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
              </div>
              <h3 class="font-bold text-base mb-2 text-dg-text">Speech-to-text</h3>
              <p class="text-sm text-dg-muted leading-relaxed flex-1">Transcribe files and URLs with nova-3. Speaker diarization, smart formatting, topic detection, and summaries — all from one command.</p>
              <div class="mt-6 px-3 py-2 rounded-lg font-mono text-xs text-dg-muted group-hover:text-dg-pebble transition-colors"
                   style="background:#0b0b0c; border: 1px solid #2c2c33;">
                <span class="text-dg-green">$</span> dg listen <span class="text-amber-400">podcast.mp3</span> --diarize
              </div>
            </div>
          </div>

          <!-- Live streaming -->
          <div class="gb-blue rounded-2xl group hover:shadow-lg hover:shadow-dg-blue/5 transition-shadow">
            <div class="rounded-2xl bg-dg-charcoal p-6" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #149afb15; border: 1px solid #149afb30;">
                <svg class="w-5 h-5 text-dg-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
              </div>
              <h3 class="font-bold text-base mb-2 text-dg-text">Live streaming</h3>
              <p class="text-sm text-dg-muted leading-relaxed">WebSocket stream from mic or stdin. Real-time transcripts with interim results and word-level timing.</p>
            </div>
          </div>

          <!-- TTS -->
          <div class="gb-purple rounded-2xl group hover:shadow-lg hover:shadow-purple-500/5 transition-shadow">
            <div class="rounded-2xl bg-dg-charcoal p-6" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #a855f715; border: 1px solid #a855f730;">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m0 0l-2-2m2 2l2-2M6.464 8.464a5 5 0 000 7.072"/></svg>
              </div>
              <h3 class="font-bold text-base mb-2 text-dg-text">Text-to-speech</h3>
              <p class="text-sm text-dg-muted leading-relaxed">Generate speech with Aura voices. Pipe to ffplay or save to file.</p>
            </div>
          </div>

          <!-- Agent — wide -->
          <div class="gb-amber rounded-2xl sm:col-span-2 group hover:shadow-lg hover:shadow-amber-400/5 transition-shadow">
            <div class="rounded-2xl bg-dg-charcoal p-6 flex flex-col sm:flex-row gap-6" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="flex-1">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #f59e0b15; border: 1px solid #f59e0b30;">
                  <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="font-bold text-base mb-2 text-dg-text">Agent-ready by default</h3>
                <p class="text-sm text-dg-muted leading-relaxed">Auto-detects Claude Code, Aider, and Codex. Disables prompts, routes status to stderr, switches to JSON — no flags needed.</p>
              </div>
              <div class="sm:w-52 rounded-xl font-mono text-xs p-3.5 leading-6 self-start flex-shrink-0"
                   style="background:#0b0b0c; border: 1px solid #2c2c33;">
                <div class="text-dg-muted mb-1"># Auto-detected</div>
                <div><span class="text-amber-400">CLAUDECODE</span>=<span class="text-dg-green">1</span></div>
                <div class="mt-2 text-dg-muted"># Explicit</div>
                <div class="text-dg-text">dg ... <span class="text-amber-400">--agent-friendly</span></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════ PIPES ══ -->
    <section class="py-28 px-6" style="border-top: 1px solid #2c2c3330;">
      <div class="max-w-5xl mx-auto grid lg:grid-cols-[1fr_1.15fr] gap-16 items-center">
        <div>
          <p class="text-xs font-bold text-dg-green uppercase tracking-widest mb-5">UNIX philosophy</p>
          <h2 class="font-black tracking-tight mb-5 leading-tight" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
            Pipe-friendly.<br/>Script-ready.
          </h2>
          <p class="text-dg-muted leading-relaxed mb-8 text-sm">
            Every command writes structured data to stdout and diagnostics to stderr.
            Switch formats with <code class="font-mono text-dg-text text-xs px-1.5 py-0.5 rounded" style="background:#1a1a1f; border: 1px solid #2c2c33;">-o json</code> or let it
            auto-switch when piped. Plays nicely with every UNIX tool you already know.
          </p>
          <div class="space-y-4">
            {[
              ['JSON / YAML / table / CSV', 'Explicit output format, or auto-JSON when piped.'],
              ['Errors to stderr', 'Clean stdout channel. No surprises in pipes.'],
              ['Exit codes everywhere', 'Non-zero on error. Works in set -e scripts.'],
            ].map(([label, desc]) => (
              <div class="flex gap-3 items-start">
                <div class="mt-0.5 w-5 h-5 rounded-full flex-shrink-0 flex items-center justify-center" style="background:#13ef9515; border: 1px solid #13ef9535;">
                  <svg class="w-2.5 h-2.5 text-dg-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-sm text-dg-text">{label}</div>
                  <div class="text-xs text-dg-muted mt-0.5">{desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-2xl shadow-black/60"
             style="border: 1px solid transparent; background: linear-gradient(#0d0d11, #0d0d11) padding-box, linear-gradient(145deg, #2c2c33 0%, #149afb25 100%) border-box;">
          <div class="flex items-center gap-1.5 px-4 py-3.5" style="background:#090909; border-bottom: 1px solid #2c2c33;">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
          </div>
          <div class="p-5 font-mono text-sm leading-7 space-y-0.5">
            <div class="text-dg-muted text-xs"># Transcribe + extract with jq</div>
            <div><span class="text-dg-green">$</span> <span class="text-dg-fog"> dg -o json listen call.mp3 \</span></div>
            <div class="pl-5 text-dg-fog">| jq <span class="text-amber-400">'.results.channels[0]
    .alternatives[0].transcript'</span></div>
            <div class="text-dg-muted pt-0.5 text-xs">"Hello and welcome to our Q1 review..."</div>

            <div class="text-dg-muted text-xs pt-3"># TTS piped to speaker</div>
            <div><span class="text-dg-green">$</span> <span class="text-dg-fog"> dg speak <span class="text-amber-400">"Hello from Deepgram"</span> \</span></div>
            <div class="pl-5 text-dg-fog">| ffplay -nodisp -autoexit -</div>

            <div class="text-dg-muted text-xs pt-3"># Stream mic → log</div>
            <div><span class="text-dg-green">$</span> <span class="text-dg-fog"> dg -o json listen --mic | tee log.jsonl</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════ COMMANDS ══ -->
    <section class="py-28 px-6" style="border-top: 1px solid #2c2c3330;">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-xs font-bold text-dg-green uppercase tracking-widest mb-5">ALL COMMANDS</p>
          <h2 class="font-black tracking-tight mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
            Every workflow, covered.
          </h2>
          <p class="text-dg-muted text-base max-w-xl mx-auto">From a quick transcription to a full production pipeline — there's a command for that.</p>
        </div>

        <div class="columns-1 sm:columns-2 lg:columns-3 gap-4">
          {commandCards.map((card) => {
            const cc = COLOR_CONF[card.color];
            return (
              <div class:list={[cc.gbClass, 'rounded-2xl mb-4 break-inside-avoid']}>
                <div class="rounded-2xl p-5" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">

                  {/* header: icon badge + command chip */}
                  <div class="flex items-center gap-2.5 mb-3">
                    <div class="w-8 h-8 rounded-lg flex-shrink-0 flex items-center justify-center"
                         style={`background:${cc.iconBg}; border:1px solid ${cc.iconBorder};`}>
                      <svg class:list={['w-4 h-4', cc.iconText]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={ICONS[card.icon]}/>
                      </svg>
                    </div>
                    <span class="font-mono text-xs px-2 py-0.5 rounded-md text-dg-muted"
                          style="background:#0b0b0c; border:1px solid #2c2c33;">
                      dg {card.cmd}
                    </span>
                  </div>

                  {/* title */}
                  <h3 class="font-semibold text-sm text-dg-text mb-1.5">{card.title}</h3>

                  {/* optional description */}
                  {card.desc && (
                    <p class="text-xs text-dg-muted leading-relaxed mb-3">{card.desc}</p>
                  )}

                  {/* code snippet */}
                  <div class="mt-3 px-3 py-2.5 rounded-lg font-mono text-xs leading-6"
                       style="background:#0b0b0c; border:1px solid #2c2c33;">
                    {card.lines.map((line, i) => (
                      <div class:list={[i > 0 && 'pl-4']}>
                        {i === 0
                          ? <><span class="text-dg-green select-none">$ </span><span class="text-dg-fog">{line}</span></>
                          : <span class="text-dg-muted">{line.trimStart()}</span>
                        }
                      </div>
                    ))}
                  </div>

                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════ INSTALL ══ -->
    <section id="install" class="py-28 px-6" style="border-top: 1px solid #2c2c3330;">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-black tracking-tight mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
