---
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// Read version from root pyproject.toml at build time — always in sync,
// no manual updates needed. process.cwd() is web/ during `npm run build`.
const _toml = readFileSync(join(process.cwd(), '..', 'pyproject.toml'), 'utf-8');
const cliVersion = _toml.match(/^version = "([^"]+)"/m)?.[1] ?? '0.0.0';
---

<html lang="en" prefix="og: https://ogp.me/ns#">
<head>
  <!-- ── Essentials ──────────────────────────────────────── -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- ── Primary SEO ────────────────────────────────────── -->
  <title>Deepgram CLI (dg) — Speech-to-Text, TTS & Audio AI from Your Terminal</title>
  <meta name="description" content="The official Deepgram CLI. Transcribe audio files, stream live speech, synthesize text-to-speech, and call the Deepgram API — all from your terminal. One-line install on macOS, Linux, and Windows." />
  <meta name="keywords" content="Deepgram CLI, speech-to-text command line, audio transcription CLI, dg command, deepctl, transcribe audio terminal, text-to-speech CLI, speech AI, nova-3 model, live transcription, audio intelligence, developer tool, speech recognition command line" />
  <meta name="author" content="Deepgram" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="https://cli.deepgram.com/" />

  <!-- ── Open Graph ──────────────────────────────────────── -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Deepgram CLI" />
  <meta property="og:title" content="Deepgram CLI — Speech AI from Your Terminal" />
  <meta property="og:description" content="Transcribe audio files, stream live speech, and synthesize voices directly from your terminal. The official CLI for Deepgram's speech AI platform." />
  <meta property="og:url" content="https://cli.deepgram.com/" />
  <meta property="og:image" content="https://cli.deepgram.com/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Deepgram CLI — Speech AI, in your terminal. Install with curl -fsSL deepgram.com/install.sh | sh" />
  <meta property="og:locale" content="en_US" />

  <!-- ── Twitter / X Card ───────────────────────────────── -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@DeepgramAI" />
  <meta name="twitter:creator" content="@DeepgramAI" />
  <meta name="twitter:title" content="Deepgram CLI — Speech AI from Your Terminal" />
  <meta name="twitter:description" content="Transcribe audio files, stream live speech, and synthesize voices directly from your terminal. Install with one command." />
  <meta name="twitter:image" content="https://cli.deepgram.com/og-image.png" />
  <meta name="twitter:image:alt" content="Deepgram CLI landing page" />

  <!-- ── Favicons & Manifest ────────────────────────────── -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#13ef95" />
  <meta name="msapplication-TileColor" content="#050506" />

  <!-- ── Fonts ──────────────────────────────────────────── -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;0,14..32,900&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />

  <!-- ── DNS prefetch ───────────────────────────────────── -->
  <link rel="dns-prefetch" href="https://deepgram.com" />
  <link rel="dns-prefetch" href="https://developers.deepgram.com" />
  <link rel="dns-prefetch" href="https://github.com" />

  <!-- ── LLMs.txt discovery ────────────────────────────── -->
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt — AI-readable site summary" />
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-full.txt — Complete CLI reference for AI" />

  <!-- ── JSON-LD Structured Data ───────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "@id": "https://cli.deepgram.com/#software",
        "name": "Deepgram CLI",
        "alternateName": ["dg", "deepctl"],
        "description": "The official command-line interface for Deepgram's speech AI platform. Transcribe audio files, stream live speech, synthesize text-to-speech, and interact with the full Deepgram API from your terminal.",
        "url": "https://cli.deepgram.com/",
        "downloadUrl": "https://deepgram.com/install.sh",
        "installUrl": "https://deepgram.com/install.sh",
        "applicationCategory": "DeveloperApplication",
        "applicationSubCategory": "Speech Recognition Software",
        "operatingSystem": ["macOS", "Linux", "Windows"],
        "softwareVersion": cliVersion,
        "releaseNotes": "https://github.com/deepgram/cli/releases",
        "softwareRequirements": "Python 3.10 or later",
        "programmingLanguage": "Python",
        "license": "https://github.com/deepgram/cli/blob/main/LICENSE",
        "codeRepository": "https://github.com/deepgram/cli",
        "screenshot": "https://cli.deepgram.com/og-image.png",
        "featureList": [
          "Speech-to-text transcription from files and URLs",
          "Live streaming transcription from microphone or stdin",
          "Text-to-speech synthesis with multiple voice models",
          "Text intelligence: sentiment, summarization, topic detection",
          "Direct Deepgram API access via CLI",
          "API key and project management",
          "AI agent detection with non-interactive mode",
          "Shell completion for bash, zsh, and fish",
          "Plugin system with isolated venv",
          "MCP server for AI editor integration",
          "Multiple output formats: JSON, YAML, table, CSV"
        ],
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "description": "Free and open source"
        },
        "publisher": {
          "@id": "https://cli.deepgram.com/#organization"
        },
        "author": {
          "@id": "https://cli.deepgram.com/#organization"
        },
        "maintainer": {
          "@id": "https://cli.deepgram.com/#organization"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://cli.deepgram.com/#organization",
        "name": "Deepgram",
        "url": "https://deepgram.com",
        "logo": "https://cli.deepgram.com/wordmark-dark.svg",
        "sameAs": [
          "https://github.com/deepgram",
          "https://twitter.com/DeepgramAI",
          "https://www.linkedin.com/company/deepgram",
          "https://www.youtube.com/@deepgram"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "developer support",
          "url": "https://developers.deepgram.com/support"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://cli.deepgram.com/#website",
        "url": "https://cli.deepgram.com/",
        "name": "Deepgram CLI",
        "description": "Official landing page for the Deepgram command-line interface",
        "publisher": {
          "@id": "https://cli.deepgram.com/#organization"
        },
        "inLanguage": "en-US"
      },
      {
        "@type": "WebPage",
        "@id": "https://cli.deepgram.com/#webpage",
        "url": "https://cli.deepgram.com/",
        "name": "Deepgram CLI — Speech-to-Text, TTS & Audio AI from Your Terminal",
        "description": "The official Deepgram CLI. Transcribe audio, stream live speech, synthesize voices, and call the Deepgram API from your terminal.",
        "isPartOf": { "@id": "https://cli.deepgram.com/#website" },
        "about": { "@id": "https://cli.deepgram.com/#software" },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Deepgram",
              "item": "https://deepgram.com"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "CLI",
              "item": "https://cli.deepgram.com"
            }
          ]
        },
        "inLanguage": "en-US",
        "potentialAction": {
          "@type": "DownloadAction",
          "target": "https://deepgram.com/install.sh",
          "name": "Install Deepgram CLI"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://cli.deepgram.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is the Deepgram CLI?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Deepgram CLI (dg or deepctl) is the official command-line interface for Deepgram's speech AI platform. It lets developers transcribe audio files and URLs, stream live speech-to-text from a microphone, synthesize text-to-speech, and interact with the full Deepgram REST API — all from the terminal."
            }
          },
          {
            "@type": "Question",
            "name": "How do I install the Deepgram CLI?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "On macOS or Linux, run: curl -fsSL deepgram.com/install.sh | sh. On Windows PowerShell, run: iwr deepgram.com/install.ps1 | iex. You can also install via pip (pip install deepctl), pipx, uvx, or Homebrew."
            }
          },
          {
            "@type": "Question",
            "name": "How do I transcribe an audio file with the Deepgram CLI?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "After logging in with 'dg login', run: dg transcribe recording.wav. You can also transcribe URLs (dg transcribe https://example.com/audio.mp3), enable speaker diarization (--diarize), select a model (--model nova-3), and export to JSON (--output json)."
            }
          },
          {
            "@type": "Question",
            "name": "Does the Deepgram CLI work with AI coding tools like Claude Code?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The Deepgram CLI auto-detects AI agent environments including Claude Code, Aider, OpenAI Codex, and others. In agent context it automatically disables interactive prompts, routes status messages to stderr, and defaults to JSON output. Pass --agent-friendly to any command to get a machine-readable JSON schema of its parameters and capabilities."
            }
          },
          {
            "@type": "Question",
            "name": "What speech-to-text models does the Deepgram CLI support?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Deepgram CLI supports all Deepgram models including nova-3 (default for streaming), nova-2, Whisper, and enhanced/base tier models. Use the --model flag or run 'dg models' to list all available models."
            }
          },
          {
            "@type": "Question",
            "name": "Can I pipe the Deepgram CLI output to other tools?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The CLI is fully UNIX-composable. Use --output json (or -o json) to get structured JSON, which can be piped to jq, grep, and other tools. When stdout is a pipe, the CLI automatically switches to JSON. Status messages always go to stderr to keep stdout clean."
            }
          }
        ]
      }
    ]
  })} />
</head>
<body class="bg-dg-black text-dg-text font-sans overflow-x-hidden" style="font-feature-settings: 'cv02','cv03','cv04','cv11';">

  <!-- dot grid -->
  <div class="fixed inset-0 pointer-events-none z-0 select-none" aria-hidden="true"
       style="background-image: radial-gradient(circle, rgba(44,44,51,0.35) 1px, transparent 1px); background-size: 28px 28px;"></div>
  <!-- vignette -->
  <div class="fixed inset-0 pointer-events-none z-0" aria-hidden="true"
       style="background: radial-gradient(ellipse 100% 50% at 50% 0%, transparent 30%, #050506 100%);"></div>

  <!-- ══════════════════════════════════════════ NAV ══ -->
  <header class="fixed top-0 inset-x-0 z-50 px-4 pt-4">
    <nav class="max-w-5xl mx-auto h-12 flex items-center justify-between px-4 rounded-2xl border border-dg-border/60 backdrop-blur-2xl bg-dg-bg/60 shadow-xl shadow-black/40">
      <!-- logo -->
      <div class="flex items-center gap-2.5">
        <img src="/wordmark-dark.svg" alt="Deepgram" style="height:18px; width:auto;" />
        <span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono font-semibold tracking-wide bg-dg-green/12 border border-dg-green/25 text-dg-green">CLI</span>
      </div>
      <!-- links -->
      <div class="flex items-center gap-5">
        <a href="https://github.com/deepgram/cli" target="_blank" rel="noopener"
           class="text-xs text-dg-muted hover:text-dg-text transition-colors duration-150 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </div>
    </nav>
  </header>

  <main class="relative z-10">

    <!-- ══════════════════════════════════════════ HERO ══ -->
    <section class="relative pt-44 pb-32 px-6 overflow-hidden">

      <!-- marketing site-style conic gradient -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] opacity-30"
             style="background: conic-gradient(from 90deg at 70% 55%, #000, #0f7466), conic-gradient(from 270deg at 30% 55%, #0f7466, #000); background-blend-mode: screen; mix-blend-mode: screen; filter: blur(60px);"></div>
        <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[400px]"
             style="background: radial-gradient(ellipse, #13ef9514 0%, transparent 70%);"></div>
        <div class="absolute top-40 left-1/4 w-80 h-80"
             style="background: radial-gradient(ellipse, #149afb0c 0%, transparent 70%);"></div>
      </div>

      <div class="relative max-w-4xl mx-auto text-center">

        <!-- badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full mb-10 text-xs text-dg-muted"
             style="border: 1px solid transparent; background: linear-gradient(#1a1a1f, #1a1a1f) padding-box, linear-gradient(90deg, #2c2c33, #13ef9540) border-box;">
          <span class="relative inline-flex">
            <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-dg-green opacity-40"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-dg-green"></span>
          </span>
          Official Deepgram Developer Tool &nbsp;·&nbsp; v{cliVersion}
        </div>

        <!-- headline — marketing site uses 96px display -->
        <h1 class="font-black tracking-tight leading-[0.92] mb-8"
            style="font-size: clamp(3rem, 8vw, 5.5rem); letter-spacing: -0.04em;">
          <span class="block text-dg-text">Speech AI,</span>
          <span class="block text-gradient" style="padding-bottom: 0.1em;">in your terminal.</span>
        </h1>

        <p class="text-lg text-dg-muted max-w-lg mx-auto mb-10 leading-relaxed font-light">
          Transcribe, synthesize, and stream audio. The official CLI for Deepgram's speech platform.
        </p>

        <!-- install chip — primary CTA -->
        <div class="inline-flex items-center gap-3 px-5 py-3.5 rounded-xl font-mono text-sm backdrop-blur-sm"
             style="border: 1px solid transparent; background: linear-gradient(#111115, #111115) padding-box, linear-gradient(90deg, #2c2c33 0%, #13ef9532 50%, #2c2c33 100%) border-box; box-shadow: 0 0 0 1px #0003, 0 8px 32px #0005;">
          <span class="text-dg-green/50 select-none">$</span>
          <span id="install-pill" class="text-dg-text">curl -fsSL deepgram.com/install.sh | sh</span>
          <button id="copy-pill" onclick="copyInstall()" aria-label="Copy"
                  class="text-dg-pebble hover:text-dg-green transition-colors ml-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- ── Terminal ── -->
      <div class="relative max-w-[660px] mx-auto mt-20">
        <!-- ambient glow -->
        <div class="absolute -inset-8 rounded-3xl pointer-events-none"
             style="background: radial-gradient(ellipse at 50% 90%, #13ef9514 0%, transparent 70%);"></div>

        <!-- gradient border using real technique -->
        <div class="rounded-2xl shadow-2xl shadow-black"
             style="border: 1px solid transparent; background: linear-gradient(#0d0d11, #0d0d11) padding-box, linear-gradient(145deg, #2c2c33 0%, #13ef9535 50%, #149afb20 100%) border-box;">
          <!-- chrome -->
          <div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid #2c2c33;">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full" style="background:#ff5f56;"></span>
              <span class="w-3 h-3 rounded-full" style="background:#ffbd2e;"></span>
              <span class="w-3 h-3 rounded-full" style="background:#27c93f;"></span>
            </div>
            <div class="font-mono text-[11px] text-dg-muted flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-dg-green/50"></span>
              dg — zsh — 80×24
            </div>
            <div class="w-14"></div>
          </div>
          <!-- body -->
          <div class="px-5 py-5 font-mono text-sm leading-7 min-h-[290px]"
               style="background: linear-gradient(180deg, #0d0d11 0%, #0f0f13 100%); border-radius: 0 0 14px 14px;">
            <div id="terminal-output" class="text-dg-fog"></div>
            <div class="flex items-center gap-2 text-dg-muted">
              <span class="text-dg-green font-bold">❯</span>
              <span id="terminal-cursor" class="inline-block w-[7px] h-[15px] rounded-sm align-middle bg-dg-green/80 cursor-blink"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════ STATS STRIP ══ -->
    <div style="border-top: 1px solid #2c2c3340; border-bottom: 1px solid #2c2c3340;">
      <div class="max-w-5xl mx-auto py-6 px-6 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        {[
          ['25+', 'Commands'],
          ['nova-3', 'Default STT model'],
          ['Python 3.10+', 'Runtime'],
          ['MIT', 'License'],
        ].map(([v, l]) => (
          <div>
            <div class="font-bold text-dg-text" style="font-size:1.25rem;">{v}</div>
            <div class="text-xs text-dg-muted mt-1">{l}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- ══════════════════════════════════════ BENTO ══ -->
    <section class="py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="font-black tracking-tight mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em;">
            Everything speech AI. One command.
          </h2>
          <p class="text-dg-muted text-base max-w-lg mx-auto">Built for developers who live in the terminal and need their tools to keep up.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

          <!-- STT — tall card -->
          <div class="gb-green rounded-2xl lg:row-span-2 group hover:shadow-lg hover:shadow-dg-green/5 transition-shadow">
            <div class="rounded-2xl h-full bg-dg-charcoal p-6 flex flex-col" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #13ef9515; border: 1px solid #13ef9530;">
                <svg class="w-5 h-5 text-dg-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
              </div>
              <h3 class="font-bold text-base mb-2 text-dg-text">Speech-to-text</h3>
              <p class="text-sm text-dg-muted leading-relaxed flex-1">Transcribe files and URLs with nova-3. Speaker diarization, smart formatting, topic detection, and summaries — all from one command.</p>
              <div class="mt-6 px-3 py-2 rounded-lg font-mono text-xs text-dg-muted group-hover:text-dg-pebble transition-colors"
                   style="background:#0b0b0c; border: 1px solid #2c2c33;">
                <span class="text-dg-green">$</span> dg listen <span class="text-amber-400">podcast.mp3</span> --diarize
              </div>
            </div>
          </div>

          <!-- Live streaming -->
          <div class="gb-blue rounded-2xl group hover:shadow-lg hover:shadow-dg-blue/5 transition-shadow">
            <div class="rounded-2xl bg-dg-charcoal p-6" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #149afb15; border: 1px solid #149afb30;">
                <svg class="w-5 h-5 text-dg-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
              </div>
              <h3 class="font-bold text-base mb-2 text-dg-text">Live streaming</h3>
              <p class="text-sm text-dg-muted leading-relaxed">WebSocket stream from mic or stdin. Real-time transcripts with interim results and word-level timing.</p>
            </div>
          </div>

          <!-- TTS -->
          <div class="gb-purple rounded-2xl group hover:shadow-lg hover:shadow-purple-500/5 transition-shadow">
            <div class="rounded-2xl bg-dg-charcoal p-6" style="background: linear-gradient(160deg, #1a1a1f 0%, #161619 100%);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: #a855f715; border: 1px solid #a855f730;">
