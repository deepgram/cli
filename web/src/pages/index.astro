<script>
  // ── Terminal typewriter ──────────────────────────────────────
  // Sequences are shuffled on every page load so returning visitors
  // are likely to see a different order.
  type Line = { p: string; t: string; c: string };
  const SEQUENCES: Line[][] = [
    // ── Auth check ────────────────────────────────
    [
      { p: '❯ ', t: 'dg whoami', c: '' },
      { p: '',   t: '✓  Authenticated', c: '#13ef95' },
      { p: '',   t: '  Profile:    default', c: '#949498' },
      { p: '',   t: '  API Key:    sk-3a8f****c91b  (keyring)', c: '#7a7a7e' },
      { p: '',   t: '  Project ID: a1b2c3d4-5e6f-7890-abcd', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── Projects ──────────────────────────────────
    [
      { p: '❯ ', t: 'dg projects --list', c: '' },
      { p: '',   t: 'Found 2 project(s):', c: '#13ef95' },
      { p: '',   t: '  • my-deepgram-project  a1b2c3d4-5e6f-7890', c: '#949498' },
      { p: '',   t: '  • staging-env          b2c3d4e5-6f78-90ab', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── File transcription with diarization ───────
    [
      { p: '❯ ', t: 'dg listen keynote.mp3 --diarize --model nova-3', c: '' },
      { p: '',   t: '✓  Transcribing · nova-3', c: '#13ef95' },
      { p: '',   t: 'Welcome to our annual product keynote. This year', c: '#949498' },
      { p: '',   t: 'we ship the fastest model yet.', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── URL transcription ─────────────────────────
    [
      { p: '❯ ', t: 'dg listen https://cdn.example.com/podcast.mp3', c: '' },
      { p: '',   t: 'Fetching remote audio…', c: '#949498' },
      { p: '',   t: '"This week on Developer Stories: the future of speech AI."', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── JSON pipeline ─────────────────────────────
    [
      { p: '❯ ', t: "dg -o json listen standup.mp3 | jq '.results.channels[0].alternatives[0].transcript'", c: '' },
      { p: '',   t: '"Blocked on auth; need a review on PR 847 by EOD."', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── Text intelligence ─────────────────────────
    [
      { p: '❯ ', t: 'dg read earnings.txt --sentiment --summarize --topics', c: '' },
      { p: '',   t: 'Analyzing text...', c: '#949498' },
      { p: '',   t: 'Summary:   Revenue beat forecasts by 23%; guidance raised.', c: '#edede2' },
      { p: '',   t: 'Sentiment: positive (0.96)', c: '#13ef95' },
      { p: '',   t: 'Topics:    • earnings (98%)  • revenue growth (91%)', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── TTS → pipe to player ──────────────────────
    [
      { p: '❯ ', t: 'dg speak "Hello from Deepgram" | ffplay -nodisp -autoexit -', c: '' },
      { p: '',   t: '✓  Synthesizing · aura-2-asteria-en', c: '#13ef95' },
      { p: '',   t: '▶  Streaming 3.2s of audio…', c: '#949498' },
      { p: '',   t: '', c: '' },
    ],
    // ── Live mic transcription ────────────────────
    [
      { p: '❯ ', t: 'dg listen --mic --model nova-3 --interim', c: '' },
      { p: '',   t: '✓  Listening on Built-in Microphone…', c: '#13ef95' },
      { p: '',   t: '"The quick brown fox jumps over the lazy dog."', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── WebVTT captions from file ─────────────────
    [
      { p: '❯ ', t: 'dg listen keynote.mp3 --webvtt --save-to keynote.vtt', c: '' },
      { p: '',   t: 'WEBVTT', c: '#13ef95' },
      { p: '',   t: '', c: '' },
      { p: '',   t: '00:00:00.080 --> 00:00:03.220', c: '#949498' },
      { p: '',   t: 'Welcome to our annual product keynote.', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── SRT with diarization ──────────────────────
    [
      { p: '❯ ', t: 'dg listen interview.mp3 --srt --diarize', c: '' },
      { p: '',   t: '1', c: '#7a7a7e' },
      { p: '',   t: '00:00:00,080 --> 00:00:05,320', c: '#949498' },
      { p: '',   t: '[speaker 0]', c: '#13ef95' },
      { p: '',   t: 'Thanks for joining us today.', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── Live mic WebVTT captions ──────────────────
    [
      { p: '❯ ', t: 'dg listen --mic --webvtt', c: '' },
      { p: '',   t: '✓  Listening on Built-in Microphone…', c: '#13ef95' },
      { p: '',   t: 'WEBVTT', c: '#949498' },
      { p: '',   t: '', c: '' },
      { p: '',   t: '00:00:00.240 --> 00:00:03.180', c: '#7a7a7e' },
      { p: '',   t: 'The quick brown fox jumps over the lazy dog.', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── ffmpeg pipe → SRT ─────────────────────────
    [
      { p: '❯ ', t: 'ffmpeg -i video.mp4 -f s16le -ar 16000 -ac 1 - | dg listen --encoding linear16 --srt', c: '' },
      { p: '',   t: '✓  Streaming stdin · nova-3', c: '#13ef95' },
      { p: '',   t: '1', c: '#7a7a7e' },
      { p: '',   t: '00:00:00,420 --> 00:00:04,180', c: '#949498' },
      { p: '',   t: 'Welcome to this week\'s engineering all-hands.', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── Explore models ────────────────────────────
    [
      { p: '❯ ', t: 'dg models --type stt', c: '' },
      { p: '',   t: '  nova-3     STT  en   2024-01-24', c: '#edede2' },
      { p: '',   t: '  nova-2     STT  en   2024-01-09', c: '#949498' },
      { p: '',   t: '  enhanced   STT  en   2022-05-09', c: '#7a7a7e' },
      { p: '',   t: '  24 model(s) found', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── Key management (dry run) ──────────────────
    [
      { p: '❯ ', t: "dg keys --create --comment 'ci-pipeline' --dry-run", c: '' },
      { p: '',   t: 'Dry run — no changes made', c: '#949498' },
      { p: '',   t: "  Would create key: comment='ci-pipeline'  scopes=member", c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── Usage stats ───────────────────────────────
    [
      { p: '❯ ', t: 'dg usage --last-month', c: '' },
      { p: '',   t: 'Usage Summary (2026-02-01 to 2026-02-28):', c: '#13ef95' },
      { p: '',   t: '  Total Requests: 1,247', c: '#949498' },
      { p: '',   t: '  Total Duration: 42.30 hours', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── Debug: failed requests ────────────────────
    [
      { p: '❯ ', t: 'dg requests --status failed --endpoint listen', c: '' },
      { p: '',   t: '  /v1/listen  streaming  failed  2026-03-28  a3f8c1d2…', c: '#949498' },
      { p: '',   t: '  1 request(s) shown', c: '#7a7a7e' },
      { p: '',   t: '', c: '' },
    ],
    // ── Raw API call ──────────────────────────────
    [
      { p: '❯ ', t: "dg api /v1/projects --jq '.projects[0].name'", c: '' },
      { p: '',   t: '"my-deepgram-project"', c: '#edede2' },
      { p: '',   t: '', c: '' },
    ],
    // ── MCP server for AI editors ─────────────────
    [
      { p: '❯ ', t: 'dg mcp --transport sse --port 8000', c: '' },
      { p: '',   t: 'Starting MCP proxy (sse) on 127.0.0.1:8000…', c: '#13ef95' },
      { p: '',   t: '  Add to your AI editor: http://127.0.0.1:8000/sse', c: '#949498' },
      { p: '',   t: '', c: '' },
    ],
  ];

  // Fisher-Yates shuffle — runs once on page load
  for (let i = SEQUENCES.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [SEQUENCES[i], SEQUENCES[j]] = [SEQUENCES[j], SEQUENCES[i]];
  }

  // Flatten sequences into the line-by-line array the typewriter consumes.
  // Drop any trailing blank lines from the final sequence so the loop
  // resets cleanly without an extra pause.
  const LINES: Line[] = SEQUENCES.flat();
  while (LINES.length > 0 && LINES[LINES.length - 1].t === '') LINES.pop();

  const out = document.getElementById('terminal-output');
  let li = 0, ci = 0, cur: HTMLElement | null = null;

  function tick() {
    if (li >= LINES.length) {
      setTimeout(() => { if (out) out.innerHTML = ''; li = 0; ci = 0; cur = null; setTimeout(tick, 400); }, 3800);
      return;
    }
    const line = LINES[li];
    if (ci === 0) {
      const row = document.createElement('div');
      row.className = 'flex gap-2';
      if (line.t === '') {
        row.innerHTML = '&nbsp;';
        out?.appendChild(row);
        li++; ci = 0; cur = null;
        setTimeout(tick, 60);
        return;
      }
      if (line.p) {
        const pfx = document.createElement('span');
        pfx.style.cssText = 'color:#13ef95; font-weight:700;';
        pfx.textContent = line.p;
        row.appendChild(pfx);
      }
      const span = document.createElement('span');
      if (line.c) span.style.color = line.c;
      row.appendChild(span);
      out?.appendChild(row);
      cur = span;
    }
    if (cur && ci < line.t.length) {
      cur.textContent += line.t[ci++];
      setTimeout(tick, line.p ? 36 : 8);
    } else {
      li++; ci = 0; cur = null;
      setTimeout(tick, line.p ? 480 : 80);
    }
  }
  setTimeout(tick, 700);

  // ── Tabs ──────────────────────────────────────────────────────
  function switchInstall(btn: HTMLElement) {
    const m = btn.dataset['method'];
    document.querySelectorAll<HTMLElement>('.install-tab').forEach(t => {
      t.classList.remove('bg-dg-charcoal', 'text-dg-text', 'shadow-sm');
      t.classList.add('text-dg-muted');
    });
    btn.classList.remove('text-dg-muted');
    btn.classList.add('bg-dg-charcoal', 'text-dg-text', 'shadow-sm');
    document.querySelectorAll<HTMLElement>('.install-block').forEach(b => {
      b.classList.toggle('hidden', b.dataset['method'] !== m);
    });
  }

  // ── Copy ─────────────────────────────────────────────────────
  function copyInstall() {
    const t = document.getElementById('install-pill')?.textContent ?? '';
    navigator.clipboard.writeText(t).then(() => {
      const b = document.getElementById('copy-pill') as HTMLElement;
      if (b) { b.style.color = '#13ef95'; setTimeout(() => { b.style.color = ''; }, 1500); }
    });
  }
  function copyCmd(t: string) { navigator.clipboard.writeText(t); }

  (window as any).switchInstall = switchInstall;
  (window as any).copyInstall = copyInstall;
  (window as any).copyCmd = copyCmd;
</script>
