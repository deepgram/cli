        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <img src="/wordmark-dark.svg" alt="Deepgram" style="height:18px; width:auto;" />
            <span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono font-semibold tracking-wide" style="background: #13ef9512; border: 1px solid #13ef9325; color: #13ef95;">CLI</span>
          </div>
          <p class="text-xs text-dg-muted leading-relaxed max-w-xs">The official CLI for Deepgram's speech AI platform. Built with ♥ by Deepgram DevRel.</p>
        </div>
        <div class="grid grid-cols-2 sm:flex sm:flex-row gap-4 sm:gap-8 text-xs text-dg-muted">
          <a href="https://developers.deepgram.com" target="_blank" rel="noopener" class="hover:text-dg-text transition-colors">Docs</a>
          <a href="https://console.deepgram.com" target="_blank" rel="noopener" class="hover:text-dg-text transition-colors">Console</a>
          <a href="https://developers.deepgram.com/reference" target="_blank" rel="noopener" class="hover:text-dg-text transition-colors">API Reference</a>
