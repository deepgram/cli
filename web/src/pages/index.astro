          <div class="flex items-center gap-3 px-5 py-4 rounded-2xl font-mono text-sm"
               style="border: 1px solid transparent; background: linear-gradient(#111115, #111115) padding-box, linear-gradient(90deg, #2c2c33 0%, #13ef9532 50%, #2c2c33 100%) border-box; box-shadow: 0 4px 24px #0003;">
            <span class="text-dg-green/50 select-none">$</span>
