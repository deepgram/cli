            }
          },
          {
            "@type": "Question",
            "name": "Does the Deepgram CLI work with AI coding tools like Claude Code?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The Deepgram CLI auto-detects AI agent environments including Claude Code, Aider, OpenAI Codex, and others. In agent context it automatically disables interactive prompts, routes status messages to stderr, and defaults to JSON output. Pass --agent-friendly to any command to get a machine-readable JSON schema of its parameters and capabilities."
            }
          },
          {
            "@type": "Question",
            "name": "What speech-to-text models does the Deepgram CLI support?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Deepgram CLI supports all Deepgram models including nova-3 (default for streaming), nova-2, Whisper, and enhanced/base tier models. Use the --model flag or run 'dg models' to list all available models."
            }
          },
          {
            "@type": "Question",
            "name": "Can I pipe the Deepgram CLI output to other tools?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The CLI is fully UNIX-composable. Use --output json (or -o json) to get structured JSON, which can be piped to jq, grep, and other tools. When stdout is a pipe, the CLI automatically switches to JSON. Status messages always go to stderr to keep stdout clean."
            }
          }
        ]
